# Credentials for local tooling that accesses an authenticated LeetCode session.
# Obtain these cookie values from your own signed-in browser session.
# Do not commit real values; use a local .env file instead.
# This setting documents the GitHub Actions repository variable of the same name.
# Set the repository variable to true to skip scheduled runs; .env cannot control GitHub Actions.

LEETCODE_SYNC_CRON_DISABLED=false
LEETCODE_CSRF_TOKEN=
LEETCODE_SESSION=
HACKERRANK_SYNC_CRON_DISABLED=false

# Raw authenticated cookie value copied from your signed-in HackerRank browser session.
# Do not include the `Cookie:` header-name prefix.
# Keep this private; it grants access to your HackerRank account.
HACKERRANK_COOKIE=
