# Optional credentials for local tooling that accesses an authenticated LeetCode session.
# Obtain these cookie values from your own signed-in browser session.
# Do not commit real values; use a local .env file instead.
# This setting documents the GitHub Actions repository variable of the same name.
# Set the repository variable to true to skip scheduled runs; .env cannot control GitHub Actions.

LEETCODE_SYNC_CRON_DISABLED=false
csrftoken=
LEETCODE_SESSION=